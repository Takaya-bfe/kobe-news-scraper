<h1>スクレイピングアプリケーション</h1>

<%= form_with url: "/scrape", method: :post, data: { turbo: false } do |form| %>
  <div>
    <%= form.label :article_url, "記事のURL" %>
    <%= form.text_field :article_url, required: true, placeholder: "スクレイピングするURLを入力" %>
  </div>

  <div>
    <%= form.submit "実行" %>
  </div>
<% end %>

<hr>

<h2>保存された記事一覧</h2>
<table class = "table_news">
  <thead>
    <tr>
      <th class ="title">タイトル</th>
      <th class = "datetime">日時</th>
      <th class = "body">本文</th>
    </tr>
  </thead>
  <tbody>
    <% @articles.each do |article| %>
      <tr>
        <td><%= article.title %></td>
        <td><%= article.published_at.strftime("%Y年%m月%d日 %H時%M分") %></td>
        <td><%= article.body%></td>
      </tr>
    <% end %>
  </tbody>
</table>